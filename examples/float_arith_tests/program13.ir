.program

.func main():float
  .frame locals=12 bytes align=4
  .slots
    local a@0:float
    local b@4:float
    local result@8:float
  .blocks
  L0:
    t0 = addr_of_symbol local:a
    store t0, #5.0:float : float
    t1 = neg #2.0:float : float
    t2 = addr_of_symbol local:b
    store t2, t1 : float

    t3 = load t0 : float
    t4 = load t2 : float
    t5 = div t3, t4 : float

    t6 = addr_of_symbol local:result
    store t6, t5 : float
    t7 = load t6 : float
    ret t7
.endfunc

.endprogram
