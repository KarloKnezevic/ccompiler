    t23 = load t22 : int32
    t24 = add t23, #1:int32 : int32
    store t19, t24 : int32
    ret

.endfunc
.func main():int32
  .frame locals=8 bytes align=4
  .slots
    local stack@0:struct Stack
  .blocks
  L0:
    t0 = addr_of_symbol local:stack
    t1 = addr_field t0, Stack.top
    store t1, #0:int32 : ptr<struct StackNode>
    t2 = addr_of_symbol local:stack
    t3 = addr_field t2, Stack.size
    store t3, #0:int32 : int32
    t4 = addr_of_symbol local:stack
    call func:push(t4, #10:int32):void
