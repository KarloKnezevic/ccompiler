.program

.type struct Stack {
  top:ptr<struct StackNode>@0
  size:int32@4
}

.func push(s:ptr<struct Stack>, value:int32):void
  .frame locals=4 bytes align=4
  .slots
    local node@0:ptr<struct StackNode>
    param s@0:ptr<struct Stack>
    param value@4:int32
  .blocks
  L0:
    t0 = addr_of_symbol local:node
    t1 = load t0 : ptr<struct StackNode>
    t2 = addr_field t1, StackNode.value
    t3 = addr_of_symbol param:value
    t4 = load t3 : int32
    store t2, t4 : int32

    t5 = load t0 : ptr<struct StackNode>
    t6 = addr_field t5, StackNode.next
    t7 = addr_of_symbol param:s
    t8 = load t7 : ptr<struct Stack>
    t9 = addr_field t8, Stack.top
    t10 = load t9 : ptr<struct StackNode>
    store t6, t10 : ptr<struct StackNode>

    t11 = load t7 : ptr<struct Stack>
    t12 = addr_field t11, Stack.top
    t13 = load t0 : ptr<struct StackNode>
    store t12, t13 : ptr<struct StackNode>

    t14 = load t7 : ptr<struct Stack>
    t15 = addr_field t14, Stack.size
    t16 = load t15 : int32
    t17 = add t16, #1:int32 : int32
    store t15, t17 : int32
    ret
.endfunc

.func main():int32
  .frame locals=8 bytes align=4
  .slots
    local stack@0:struct Stack
  .blocks
  L0:
    t0 = addr_of_symbol local:stack
    t1 = addr_field t0, Stack.top
    store t1, null:ptr<struct StackNode> : ptr<struct StackNode>
    t2 = addr_field t0, Stack.size
    store t2, #0:int32 : int32
    call func:push(t0, #10:int32) : void
    ret #0:int32
.endfunc

.endprogram
