.program

.func main():float
  .frame locals=16 bytes align=4
  .slots
    local a@0:float
    local b@4:float
    local c@8:float
    local result@12:float
  .blocks
  L0:
    t0 = addr_of_symbol local:a
    store t0, #2.0:float : float
    t1 = addr_of_symbol local:b
    store t1, #3.0:float : float
    t2 = addr_of_symbol local:c
    store t2, #4.0:float : float

    t3 = load t0 : float
    t4 = load t1 : float
    t5 = load t2 : float
    t6 = mul t4, t5 : float
    t7 = add t3, t6 : float

    t8 = div #8.0:float, #2.0:float : float

    t9 = sub t7, t8 : float

    t10 = addr_of_symbol local:result
    store t10, t9 : float
    t11 = load t10 : float
    ret t11
.endfunc

.endprogram
