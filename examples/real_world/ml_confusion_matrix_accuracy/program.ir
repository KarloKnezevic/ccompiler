.program

.globals
  global pred:array<int32,8> = { #1:int32, #1:int32, #1:int32, #0:int32, #0:int32, #0:int32, #1:int32, #0:int32 } : array<int32,8>
  global truth:array<int32,8> = { #1:int32, #0:int32, #1:int32, #1:int32, #0:int32, #0:int32, #1:int32, #0:int32 } : array<int32,8>

.func main():int32
  .frame locals=8 bytes align=4
  .slots
    local correct@0:int32
    local i@4:int32
  .blocks
  L0:
    t0 = addr_of_symbol local:correct
    store t0, #0:int32 : int32
    t1 = addr_of_symbol local:i
    store t1, #0:int32 : int32
    jmp L1
  L1:
    t2 = addr_of_symbol local:i
    t3 = load t2 : int32
    t4 = cmp_lt t3, #8:int32 : bool
    br t4, L2, L3
  L2:
    t5 = addr_of_symbol global:truth
    t6 = addr_of_symbol local:i
    t7 = load t6 : int32
    t8 = addr_index t5, t7, 4
    t9 = load t8 : int32
    t10 = addr_of_symbol global:pred
    t11 = addr_index t10, t7, 4
    t12 = load t11 : int32
    t13 = cmp_eq t9, t12 : bool
    br t13, L4, L5
  L3:
    t20 = addr_of_symbol local:correct
    t21 = load t20 : int32
    ret t21
  L4:
    t14 = addr_of_symbol local:correct
    t15 = load t14 : int32
    t16 = add t15, #1:int32 : int32
    store t14, t16 : int32
    jmp L6
  L5:
    jmp L6
  L6:
    t17 = addr_of_symbol local:i
    t18 = load t17 : int32
    t19 = add t18, #1:int32 : int32
    store t17, t19 : int32
    jmp L1
.endfunc

.endprogram
