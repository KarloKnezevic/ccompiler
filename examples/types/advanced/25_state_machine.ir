.program

.type struct State {
  id:int32@0
  value:int32@4
  next:ptr<struct State>@8
}

.type struct StateMachine {
  current:ptr<struct State>@0
  step_count:int32@4
  total_value:int32@8
}

.func calculate_total(sm:ptr<struct StateMachine>):int32
  .frame locals=8 bytes align=4
  .slots
    local curr@0:ptr<struct State>
    param sm@0:ptr<struct StateMachine>
    local total@4:int32
  .blocks
  L0:
    t0 = addr_of_symbol local:total
    store t0, #0:int32 : int32

    t1 = addr_of_symbol param:sm
    t2 = load t1 : ptr<struct StateMachine>
    t3 = addr_field t2, StateMachine.current
    t4 = load t3 : ptr<struct State>
    t5 = addr_of_symbol local:curr
    store t5, t4 : ptr<struct State>

    t6 = load t0 : int32
    t7 = load t5 : ptr<struct State>
    t8 = addr_field t7, State.value
    t9 = load t8 : int32
    t10 = add t6, t9 : int32
    store t0, t10 : int32

    t11 = load t5 : ptr<struct State>
    t12 = addr_field t11, State.next
    t13 = load t12 : ptr<struct State>
    store t5, t13 : ptr<struct State>
    t14 = load t5 : ptr<struct State>
    t15 = cmp_ne t14, #0:int32 : bool
    br t15, L1, L2
  L1:
    t16 = addr_of_symbol local:total
    t17 = load t16 : int32
    t18 = addr_of_symbol local:curr
    t19 = load t18 : ptr<struct State>
    t20 = addr_field t19, State.value
    t21 = load t20 : int32
    t22 = add t17, t21 : int32
    store t16, t22 : int32
    jmp L3
  L2:
    jmp L3
  L3:
    t23 = addr_of_symbol local:total
    t24 = load t23 : int32
    ret t24
.endfunc

.func main():int32
  .frame locals=40 bytes align=4
  .slots
    local sm@0:struct StateMachine
    local s1@12:struct State
    local s2@24:struct State
    local result@36:int32
  .blocks
  L0:
    t0 = addr_of_symbol local:sm
    t1 = addr_field t0, StateMachine.current
    store t1, null:ptr<struct State> : ptr<struct State>
    t2 = addr_field t0, StateMachine.step_count
    store t2, #0:int32 : int32
    t3 = addr_field t0, StateMachine.total_value
    store t3, #0:int32 : int32

    t4 = addr_of_symbol local:s1
    t5 = addr_field t4, State.id
    store t5, #1:int32 : int32
    t6 = addr_field t4, State.value
    store t6, #5:int32 : int32

    t7 = addr_of_symbol local:s2
    t8 = addr_field t7, State.id
    store t8, #2:int32 : int32
    t9 = addr_field t7, State.value
    store t9, #10:int32 : int32
    t10 = addr_field t4, State.next
    store t10, t7 : ptr<struct State>
    t11 = addr_field t7, State.next
    store t11, null:ptr<struct State> : ptr<struct State>
    store t1, t4 : ptr<struct State>
    t12 = call func:calculate_total(t0) : int32
    t13 = addr_of_symbol local:result
    store t13, t12 : int32
    t14 = load t13 : int32
    ret t14
.endfunc

.endprogram
