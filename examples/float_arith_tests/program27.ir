.program

.func helper(a:float, b:float, c:float):float
  .frame locals=0 bytes align=4
  .slots
    param a@0:float
    param b@4:float
    param c@8:float
  .blocks
  L0:
    t0 = addr_of_symbol param:a
    t1 = load t0 : float
    t2 = addr_of_symbol param:b
    t3 = load t2 : float
    t4 = mul t1, t3 : float

    t5 = addr_of_symbol param:c
    t6 = load t5 : float
    t7 = add t6, #1.0:float : float
    t8 = div t4, t7 : float
    ret t8
.endfunc

.func main():float
  .frame locals=16 bytes align=4
  .slots
    local x@0:float
    local y@4:float
    local z@8:float
    local result@12:float
  .blocks
  L0:
    t0 = addr_of_symbol local:x
    store t0, #6.0:float : float
    t1 = addr_of_symbol local:y
    store t1, #2.0:float : float
    t2 = addr_of_symbol local:z
    store t2, #2.0:float : float

    t3 = load t0 : float
    t4 = load t1 : float
    t5 = load t2 : float
    t6 = call func:helper(t3, t4, t5) : float
    t7 = addr_of_symbol local:result
    store t7, t6 : float
    t8 = load t7 : float
    ret t8
.endfunc

.endprogram
