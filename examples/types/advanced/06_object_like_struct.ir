}

.type struct Rectangle {
  top_left:ptr<struct Point>@0
  bottom_right:ptr<struct Point>@4
}

.func calculate_area(rect:ptr<struct Rectangle>):int32
  .frame locals=8 bytes align=4
  .slots
    param rect@0:ptr<struct Rectangle>
    local width@0:int32
    local height@4:int32
  .blocks
  L0:
    t0 = addr_of_symbol param:rect
    t1 = load t0 : ptr<struct Rectangle>
    t2 = addr_field t1, Rectangle.bottom_right
    t3 = load t2 : ptr<struct Point>
    t4 = addr_field t3, Point.x
    t5 = load t4 : int32
    t6 = load t0 : ptr<struct Rectangle>
    t7 = addr_field t6, Rectangle.top_left
    t8 = load t7 : ptr<struct Point>
    t9 = addr_field t8, Point.x
    t10 = load t9 : int32
    t11 = sub t5, t10 : int32

    t12 = addr_of_symbol local:width
    store t12, t11 : int32

    t13 = load t0 : ptr<struct Rectangle>
    t14 = addr_field t13, Rectangle.top_left
    t15 = load t14 : ptr<struct Point>
    t16 = addr_field t15, Point.y
    t17 = load t16 : int32
    t18 = load t0 : ptr<struct Rectangle>
    t19 = addr_field t18, Rectangle.bottom_right
    t20 = load t19 : ptr<struct Point>
    t21 = addr_field t20, Point.y
    t22 = load t21 : int32
    t23 = sub t17, t22 : int32

    t24 = addr_of_symbol local:height
    store t24, t23 : int32

    t25 = load t12 : int32
    t26 = load t24 : int32
    t27 = mul t25, t26 : int32
    ret t27
.endfunc

.func main():int32
  .frame locals=28 bytes align=4
  .slots
    local rect@0:struct Rectangle
    local p1@8:struct Point
    local p2@16:struct Point
    local area@24:int32
  .blocks
  L0:
    t0 = addr_of_symbol local:p1
    t1 = addr_field t0, Point.x
    store t1, #0:int32 : int32
    t2 = addr_field t0, Point.y
    store t2, #10:int32 : int32

    t3 = addr_of_symbol local:p2
    t4 = addr_field t3, Point.x
    store t4, #5:int32 : int32
    t5 = addr_field t3, Point.y
    store t5, #0:int32 : int32

    t6 = addr_of_symbol local:rect
    t7 = addr_field t6, Rectangle.top_left
    store t7, t0 : ptr<struct Point>
    t8 = addr_field t6, Rectangle.bottom_right
    store t8, t3 : ptr<struct Point>
    t9 = call func:calculate_area(t6) : int32
    t10 = addr_of_symbol local:area
    store t10, t9 : int32
    t11 = load t10 : int32
