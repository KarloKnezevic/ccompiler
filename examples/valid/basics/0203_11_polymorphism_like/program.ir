.program

.type struct Circle {
  base:struct Shape@0
  radius:float@8
}

.type struct Shape {
  type:int32@0
  area:float@4
}

.func calculate_circle_area(radius:float):float
  .frame locals=0 bytes align=4
  .slots
    param radius@0:float
  .blocks
  L0:
    t0 = addr_of_symbol param:radius
    t1 = load t0 : float
    t2 = mul #3.14:float, t1 : float
    t3 = mul t2, t1 : float
    ret t3
.endfunc

.func main():int32
  .frame locals=16 bytes align=4
  .slots
    local circle@0:struct Circle
    local area@12:float
  .blocks
  L0:
    t0 = addr_of_symbol local:circle
    t1 = addr_field t0, Circle.base
    t2 = addr_field t1, Shape.type
    store t2, #1:int32 : int32
    t3 = addr_field t0, Circle.radius
    store t3, #5.0:float : float

    t4 = load t3 : float
    t5 = call func:calculate_circle_area(t4) : float
    t6 = addr_of_symbol local:area
    store t6, t5 : float
    t7 = addr_field t1, Shape.area
    t8 = load t6 : float
    store t7, t8 : float
    t9 = load t6 : float
    t10 = ftoi t9 : int32
    ret t10
.endfunc

.endprogram
