.program

.func main():float
  .frame locals=20 bytes align=4
  .slots
    local a@0:float
    local b@4:float
    local c@8:float
    local d@12:float
    local result@16:float
  .blocks
  L0:
    t0 = addr_of_symbol local:a
    store t0, #6.0:float : float
    t1 = addr_of_symbol local:b
    store t1, #2.0:float : float
    t2 = addr_of_symbol local:c
    store t2, #3.0:float : float
    t3 = addr_of_symbol local:d
    store t3, #1.0:float : float

    t4 = load t0 : float
    t5 = load t1 : float
    t6 = load t2 : float
    t7 = load t3 : float
    t8 = div t6, t7 : float
    t9 = add t5, t8 : float
    t10 = mul t4, t9 : float

    t11 = sub t10, #5.0:float : float

    t12 = addr_of_symbol local:result
    store t12, t11 : float
    t13 = load t12 : float
    ret t13
.endfunc

.endprogram
