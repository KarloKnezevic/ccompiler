F_FMUL                          ; Q16.16 float multiplication
        PUSH R5
        MOVE R7, R5
        LOAD R0, (R5+8)         ; a
        LOAD R1, (R5+0C)        ; b
        MOVE 0, R6              ; sign
        MOVE 0, R3              ; zero
        CMP R0, 0
        JP_SGE L_FMUL_A_POS_1
        SUB R3, R0, R0
        XOR R6, 1, R6
L_FMUL_A_POS_1
        CMP R1, 0
        JP_SGE L_FMUL_B_POS_2
        SUB R3, R1, R1
        XOR R6, 1, R6
L_FMUL_B_POS_2
        MOVE 0, R2              ; prod low
        MOVE 0, R3              ; prod high
        MOVE 0, R4              ; multiplicand high
L_FMUL_LOOP_3
        CMP R1, 0
        JP_EQ L_FMUL_DONE_4
        SHR R1, 1, R1
        JP_NC L_FMUL_SKIP_5
        ADD R2, R0, R2
        ADC R3, R4, R3
L_FMUL_SKIP_5
        SHL R0, 1, R0
        ADC R4, R4, R4
        JP L_FMUL_LOOP_3
L_FMUL_DONE_4
        SHR R2, 10, R2          ; lo >> 16
        SHL R3, 10, R3          ; hi << 16
        OR R3, R2, R2           ; combine
        CMP R6, 0
        JP_EQ L_FMUL_SIGN_DONE_6
        MOVE 0, R1
        SUB R1, R2, R2
L_FMUL_SIGN_DONE_6
        MOVE R2, R6
        POP R5
        RET
F_FDIV                          ; Q16.16 float division
        PUSH R5
        MOVE R7, R5
        LOAD R0, (R5+8)         ; a
        LOAD R1, (R5+0C)        ; b
        MOVE 0, R6              ; sign
        MOVE 0, R4              ; zero
        CMP R1, 0
        JP_EQ L_FDIV_ZERO_7
        CMP R0, 0
        JP_SGE L_FDIV_A_POS_8
        SUB R4, R0, R0
        XOR R6, 1, R6
L_FDIV_A_POS_8
        CMP R1, 0
        JP_SGE L_FDIV_B_POS_9
        SUB R4, R1, R1
        XOR R6, 1, R6
L_FDIV_B_POS_9
        PUSH R6                 ; Save sign
        PUSH R0                 ; Save a
        PUSH R1                 ; Save b
        PUSH R1                 ; Arg right
        PUSH R0                 ; Arg left
        CALL F_DIV
        ADD R7, 8, R7           ; Clean args
        MOVE R6, R3             ; Integer part
        POP R1                  ; Restore b
        POP R0                  ; Restore a
        PUSH R1                 ; Save b
        PUSH R1                 ; Arg right
        PUSH R0                 ; Arg left
        CALL F_MOD
        ADD R7, 8, R7           ; Clean args
        POP R4                  ; Restore b
        MOVE R6, R2             ; Remainder
        POP R6                  ; Restore sign
        MOVE 0, R1              ; Fraction
        MOVE 10, R0             ; Loop count (16)
L_FDIV_FRAC_LOOP_10
        CMP R0, 0
        JP_EQ L_FDIV_FRAC_DONE_11
        SHL R2, 1, R2
        SHL R1, 1, R1
        CMP R2, R4
        JP_SLT L_FDIV_FRAC_SKIP_12
        SUB R2, R4, R2
        OR R1, 1, R1
L_FDIV_FRAC_SKIP_12
        SUB R0, 1, R0
        JP L_FDIV_FRAC_LOOP_10
L_FDIV_FRAC_DONE_11
        SHL R3, 10, R3          ; int << 16
        OR R3, R1, R3           ; combine
        CMP R6, 0
        JP_EQ L_FDIV_SIGN_DONE_13
        MOVE 0, R0
        SUB R0, R3, R3
L_FDIV_SIGN_DONE_13
        MOVE R3, R6
        POP R5
        RET
L_FDIV_ZERO_7
        MOVE 0, R6
        POP R5
        RET
F_I2F                           ; int32 to Q16.16
        PUSH R5
        MOVE R7, R5
        LOAD R0, (R5+8)
        SHL R0, 10, R0
        MOVE R0, R6
        POP R5
        RET
F_DIV                           ; int32 division
        PUSH R5
        MOVE R7, R5
        LOAD R0, (R5+8)         ; dividend
        LOAD R1, (R5+0C)        ; divisor
        MOVE 0, R4              ; zero
        CMP R1, 0
        JP_EQ L_DIV_ZERO_14
        MOVE 0, R6              ; sign
        CMP R0, 0
        JP_SGE L_DIV_A_POS_15
        SUB R4, R0, R0
        XOR R6, 1, R6
L_DIV_A_POS_15
        CMP R1, 0
        JP_SGE L_DIV_B_POS_16
        SUB R4, R1, R1
        XOR R6, 1, R6
L_DIV_B_POS_16
        MOVE 0, R2              ; remainder
        MOVE 0, R3              ; quotient
        MOVE 20, R4             ; bit count (32)
L_DIV_LOOP_17
        SHL R0, 1, R0
        JP_NC L_DIV_NO_CARRY_18
        SHL R2, 1, R2
        OR R2, 1, R2
        JP L_DIV_AFTER_CARRY_19
L_DIV_NO_CARRY_18
        SHL R2, 1, R2
L_DIV_AFTER_CARRY_19
        SHL R3, 1, R3
        CMP R2, R1
        JP_SLT L_DIV_SKIP_SUB_20
        SUB R2, R1, R2
        OR R3, 1, R3
L_DIV_SKIP_SUB_20
        SUB R4, 1, R4
        JP_NE L_DIV_LOOP_17
        CMP R6, 0
        JP_EQ L_DIV_SIGN_DONE_21
        SUB R4, R3, R3
L_DIV_SIGN_DONE_21
        MOVE R3, R6
        POP R5
        RET
L_DIV_ZERO_14
        MOVE 0, R6
        POP R5
        RET
F_MOD                           ; int32 modulo
        PUSH R5
        MOVE R7, R5
        LOAD R0, (R5+8)         ; dividend
        LOAD R1, (R5+0C)        ; divisor
        MOVE 0, R4              ; zero
        CMP R1, 0
        JP_EQ L_MOD_ZERO_22
        MOVE 0, R6              ; sign
        CMP R0, 0
        JP_SGE L_MOD_A_POS_23
        SUB R4, R0, R0
        MOVE 1, R6
L_MOD_A_POS_23
        CMP R1, 0
        JP_SGE L_MOD_B_POS_24
        SUB R4, R1, R1
L_MOD_B_POS_24
        MOVE 0, R2              ; remainder
        MOVE 20, R4             ; bit count (32)
L_MOD_LOOP_25
        SHL R0, 1, R0
        JP_NC L_MOD_NO_CARRY_26
        SHL R2, 1, R2
        OR R2, 1, R2
        JP L_MOD_AFTER_CARRY_27
L_MOD_NO_CARRY_26
        SHL R2, 1, R2
L_MOD_AFTER_CARRY_27
        CMP R2, R1
        JP_SLT L_MOD_SKIP_SUB_28
        SUB R2, R1, R2
L_MOD_SKIP_SUB_28
        SUB R4, 1, R4
        JP_NE L_MOD_LOOP_25
        CMP R6, 0
        JP_EQ L_MOD_SIGN_DONE_29
        SUB R4, R2, R2
L_MOD_SIGN_DONE_29
        MOVE R2, R6
        POP R5
        RET
L_MOD_ZERO_22
        MOVE 0, R6
        POP R5
        RET
L_BOUNDS_ERROR                  ; array bounds error
        MOVE -6, R6             ; Error code
        HALT                    ; Abort
; ===========================================================================
; Global Variables
; ===========================================================================
G_LABEL DW 1, 1, 0, 0           ; array
G_X DW 10000, 20000, -10000, -20000 ; array
G_Y DW 10000, 0, -10000, 0      ; array
