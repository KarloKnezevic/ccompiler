.program

.func main():float
  .frame locals=12 bytes align=4
  .slots
    local x@0:float
    local y@4:float
    local z@8:float
  .blocks
  L0:
    t0 = addr_of_symbol local:x
    store t0, #1.5:float : float
    t1 = addr_of_symbol local:y
    store t1, #2.5:float : float
    t2 = addr_of_symbol local:z
    store t2, #3.5:float : float

    t3 = load t0 : float
    t4 = load t1 : float
    t5 = mul t3, t4 : float
    t6 = load t2 : float
    t7 = mul t5, t6 : float
    ret t7
.endfunc

.endprogram
