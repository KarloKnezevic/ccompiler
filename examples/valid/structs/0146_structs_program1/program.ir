.program

.type struct Point {
  x:int32@0
  y:int32@4
}

.func main():int32
  .frame locals=8 bytes align=4
  .slots
    local p@0:struct Point
  .blocks
  L0:
    t0 = addr_of_symbol local:p
    t1 = addr_field t0, Point.x
    store t1, #10:int32 : int32
    t2 = addr_field t0, Point.y
    store t2, #20:int32 : int32

    t3 = load t1 : int32
    t4 = load t2 : int32
    t5 = add t3, t4 : int32
    ret t5
.endfunc

.endprogram
