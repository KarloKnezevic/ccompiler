.program

.func main():float
  .frame locals=20 bytes align=4
  .slots
    local i@0:int32
    local x@4:float
    local r1@8:float
    local r2@12:float
    local result@16:float
  .blocks
  L0:
    t0 = addr_of_symbol local:i
    store t0, #3:int32 : int32
    t1 = addr_of_symbol local:x
    store t1, #2.5:float : float

    t2 = load t0 : int32
    t3 = itof t2 : float
    t4 = load t1 : float
    t5 = mul t3, t4 : float

    t6 = addr_of_symbol local:r1
    store t6, t5 : float

    t7 = load t1 : float
    t8 = load t0 : int32
    t9 = itof t8 : float
    t10 = div t7, t9 : float

    t11 = addr_of_symbol local:r2
    store t11, t10 : float

    t12 = load t6 : float
    t13 = load t11 : float
    t14 = add t12, t13 : float

    t15 = addr_of_symbol local:result
    store t15, t14 : float
    t16 = load t15 : float
    ret t16
.endfunc

.endprogram
