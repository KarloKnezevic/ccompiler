.program

.func main():float
  .frame locals=16 bytes align=4
  .slots
    local a@0:float
    local b@4:float
    local c@8:float
    local result@12:float
  .blocks
  L0:
    t0 = addr_of_symbol local:a
    store t0, #7.0:float : float
    t1 = addr_of_symbol local:b
    store t1, #4.0:float : float
    t2 = addr_of_symbol local:c
    store t2, #2.0:float : float

    t3 = load t0 : float
    t4 = load t1 : float
    t5 = add t3, t4 : float

    t6 = load t2 : float
    t7 = div t5, t6 : float

    t8 = addr_of_symbol local:result
    store t8, t7 : float
    t9 = load t8 : float
    ret t9
.endfunc

.endprogram
