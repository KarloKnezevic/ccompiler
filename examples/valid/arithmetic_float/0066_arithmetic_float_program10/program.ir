.program

.func main():float
  .frame locals=12 bytes align=4
  .slots
    local a@0:float
    local b@4:float
    local result@8:float
  .blocks
  L0:
    t0 = addr_of_symbol local:a
    store t0, #1000.0:float : float
    t1 = addr_of_symbol local:b
    store t1, #3.0:float : float

    t2 = load t0 : float
    t3 = load t1 : float
    t4 = div t2, t3 : float

    t5 = addr_of_symbol local:result
    store t5, t4 : float
    t6 = load t5 : float
    ret t6
.endfunc

.endprogram
