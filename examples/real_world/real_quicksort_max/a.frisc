        JP_NE L_ZERO_14
L_MAIN_L0
        MOVE 0, R0
        STORE R0, (R5-10)       ; Save arg
        MOVE 13, R0
        STORE R0, (R5-14)       ; Save arg
        SUB R7, 8, R7           ; Allocate args
        LOAD R0, (R5-10)        ; Load arg
        STORE R0, (R7)          ; Store arg
        LOAD R0, (R5-14)        ; Load arg
        STORE R0, (R7+4)        ; Store arg
        CALL F_QUICKSORT        ; Call quicksort
        ADD R7, 8, R7           ; Clean args
        MOVE G_A, R0            ; Address of global
        STORE R0, (R5-4)        ; Store temp t0
        LOAD R0, (R5-4)         ; Load temp t0
        PUSH R0                 ; Save base address
        MOVE 13, R0
        MOVE R0, R1             ; Index
        POP R0                  ; Restore base
        CMP R1, 0               ; Bounds check
        JP_SLT L_BOUNDS_ERROR
        CMP R1, 14
        JP_SGE L_BOUNDS_ERROR
        SHL R1, 2, R1           ; Index * 4
        ADD R0, R1, R0          ; Base + offset
        STORE R0, (R5-8)        ; Store temp t1
        LOAD R0, (R5-8)         ; Load temp t1
        LOAD R0, (R0)           ; Load word
        STORE R0, (R5-0C)       ; Store temp t2
        LOAD R0, (R5-0C)        ; Load temp t2
        MOVE R0, R6             ; Set return value
        JP L_EXIT_F_MAIN_13
L_EXIT_F_MAIN_13                ; Function epilogue
        ADD R7, 14, R7          ; Deallocate locals/temps
        POP R5                  ; Restore FP
        RET                     ; Return
L_BOUNDS_ERROR                  ; array bounds error
        MOVE -6, R6             ; Error code
        HALT                    ; Abort
; ===========================================================================
; Global Variables
; ===========================================================================
G_A DW 0C, -3, 2D, 7, 7, 0, -32, 17, 5, -1, 2D, 9, 10, -14, 21, 2, -8, 32, -4, 0C ; array
