.program

.type struct Point {
  x:int32@0
  y:int32@4
}

.func main():int32
  .frame locals=16 bytes align=4
  .slots
    local p@0:struct Point
    local q@8:struct Point
  .blocks
  L0:
    t0 = addr_of_symbol local:p
    t1 = addr_field t0, Point.x
    store t1, #10:int32 : int32

    t2 = addr_of_symbol local:p
    t3 = addr_field t2, Point.y
    store t3, #20:int32 : int32

    t4 = addr_of_symbol local:p
    t5 = load t4 : struct Point

    t6 = addr_of_symbol local:q
    store t6, t5 : struct Point

    t7 = addr_of_symbol local:q
    t8 = addr_field t7, Point.x
    t9 = load t8 : int32

    t10 = addr_of_symbol local:q
    t11 = addr_field t10, Point.y
    t12 = load t11 : int32

    t13 = add t9, t12 : int32
    ret t13
.endfunc

.endprogram
